# ---------------------------------------------------------------------------
# V-Base backend — environment template
#
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
#   copy backend\.env.example backend\.env      (Windows)
#   cp backend/.env.example backend/.env        (bash)
#
# The API refuses to start with ENVIRONMENT=production while SECRET_KEY is the
# placeholder below or DATABASE_URL still points at the local development
# database, so a misconfigured deployment fails fast instead of running
# insecurely.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=V-Base
APP_VERSION=0.2.0
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# The browser origin allowed to call this API. Must match the deployed
# frontend exactly, including the scheme, e.g.
#   https://vbase.<your-subdomain>.workers.dev
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins (custom domain, preview deployments, ...).
EXTRA_ALLOWED_ORIGINS=

# --- PostgreSQL (required) -------------------------------------------------
# V-Base runs on PostgreSQL only. Pick a genuinely free tier and copy its
# POOLED connection string, then change the driver prefix to postgresql+asyncpg.
#
#   Neon Free (no card, no expiry, 1 GB/project):
#     postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   Tiger Cloud Free (no card, 750 MB/service): same shape.
#
# The "-pooler" hostname means PgBouncer in transaction mode; prepared-statement
# caching is then disabled automatically.
DATABASE_URL=postgresql+asyncpg://vbase:vbase_dev_pw@127.0.0.1:5433/vbase

# Connection pool. Keep these small on a free tier (Neon's 0.25 CU compute
# allows ~97 application connections in total).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Recycle below the provider's idle timeout so a suspended compute never hands
# back a dead socket.
DB_POOL_RECYCLE=600
DB_ECHO=false
# Set true when every query runs in a fresh event loop (serverless handlers).
DB_USE_NULL_POOL=false
# 0 is forced automatically behind a transaction pooler.
DB_STATEMENT_CACHE_SIZE=100
DB_COMMAND_TIMEOUT=30

# --- Sessions / auth -------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-do-not-use-this
SESSION_COOKIE_NAME=vbase_session
SESSION_MAX_AGE_SECONDS=604800
# Forced on automatically when ENVIRONMENT=production.
SESSION_COOKIE_SECURE=false

# --- Uploads & backups -----------------------------------------------------
# Absolute or project-relative paths. On a managed host the filesystem is
# ephemeral, so treat these as a cache and rely on the provider for durability.
UPLOADS_DIR=
BACKUPS_DIR=
# Paths to the client binaries. When pg_dump is absent, backups fall back to
# validated JSON snapshots instead of failing.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# --- Outbound email (optional) ---------------------------------------------
# Lets the CRM send an email straight from a contact record. Create a key at
# https://resend.com/api-keys and verify the sending domain first; an unverified
# From address is refused by the provider. Leave EMAIL_API_KEY blank to keep the
# feature read-only. All four values can also be stored from Settings instead of
# the environment, in which case only the API key has to be supplied here.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=V-Base <crm@your-domain.com>
# EMAIL_FROM_NAME=V-Base
# EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=15

# --- Gmail (alternative provider, GOOGLE OAuth) ----------------------------
# Sends from your own Google Workspace or Gmail mailbox through the Gmail API.
# Create an OAuth client of type "Web application" in Google Cloud, enable the
# Gmail API, and add this authorised redirect URI:
#     <your API origin>/api/v1/email/gmail/callback
# Set the first two here, then press Connect Gmail in Settings -> General; the
# refresh token is obtained through the consent screen and stored in the
# database, so it does not belong in this file. GMAIL_REDIRECT_URI only needs
# setting when a proxy rewrites the request URL.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_SENDER=
# GMAIL_REDIRECT_URI=

# --- Delivery tracking (optional) ------------------------------------------
# Lets the provider report delivered / opened / bounced events back to the API.
# Copy the signing secret (whsec_...) from the provider's webhook settings and
# point that webhook at <your API origin>/api/v1/email/webhook/resend.
# Unsigned events are refused, so this stays disabled until it is set.
# EMAIL_WEBHOOK_SECRET=whsec_...

# --- Email sequences ------------------------------------------------------
# The dispatcher wakes up this often and sends whatever has come due. Progress
# lives in the database, so a restart simply picks the clock back up.
SEQUENCE_POLL_SECONDS=60
# Steps sent per poll, so one wake-up cannot blast an entire list at once.
SEQUENCE_BATCH_SIZE=25
# Set to false to drive sequences from cron instead of the app process.
# SEQUENCES_POLL_ENABLED=true

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
# Credential endpoints (login, signup, change password) are deliberately tight.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Session probes (GET /auth/me, /auth/sessions) run on every page load, so this
# ceiling has to allow normal navigation bursts. Setting it as low as the auth
# limit makes the SPA unable to determine whether a session exists.
RATE_LIMIT_SESSION_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=240
