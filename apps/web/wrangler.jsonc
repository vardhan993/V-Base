{
  // ---------------------------------------------------------------------------
  // V-Base frontend — Cloudflare Workers Static Assets.
  //
  // Static-assets-only deployment: there is no Worker script. Cloudflare serves
  // the built SPA from ./dist and, because the app uses client-side routing with
  // hashes and history paths, unknown routes fall back to index.html.
  //
  // Deploy:
  //   cd apps/web
  //   npm run build
  //   npx wrangler deploy
  //
  // The API origin is baked in at build time, so set it before building:
  //   VITE_API_BASE=https://vbase-api.onrender.com/api/v1   (apps/web/.env)
  // ---------------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbase",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for any path that is not a real asset, so a hard refresh
    // on /companies/42 renders the SPA instead of a 404.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
