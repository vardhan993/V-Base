# ---------------------------------------------------------------------------
# V-Base frontend — environment template
#
# Copy to apps/web/.env for local development:
#   copy apps\web\.env.example apps\web\.env      (Windows)
#   cp apps/web/.env.example apps/web/.env        (bash)
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret,
# database credential or API key in a VITE_ variable — anything here is public.
# ---------------------------------------------------------------------------

# Where the browser should send API requests. The value is baked into the build,
# so set it before `npm run build` for each environment.
#
#   Development (default) — leave blank: Vite proxies /api to http://127.0.0.1:8000
#     VITE_API_BASE=
#
#   Frontend and API on different origins, e.g. Cloudflare Workers Static Assets
#   serving dist/ with the FastAPI backend on Render:
#     VITE_API_BASE=https://vbase-api.onrender.com/api/v1
#
#   Same origin behind a reverse proxy: leave blank and proxy /api/v1 to the API.
VITE_API_BASE=
